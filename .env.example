# Supabase Postgres Connection String
# Para entornos Serverless (Vercel), se recomienda la URL del Pooler en modo Transaction (puerto 6543):
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-super-secret-password@db.your-project-ref.supabase.co:5432/postgres

# Configuración de Entorno
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Monopoly Arena API"
